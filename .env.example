# MySQL Database Credentials
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=nibog_db

# JWT Secret Key
JWT_SECRET=your-secret-key-change-in-production

# Google OAuth Configuration
# Get your Client ID from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
# Client Secret (for server-side OAuth flows if needed)
GOOGLE_CLIENT_SECRET=

# PhonePe status verification — supply real values only through server secrets, never a real key here.
PHONEPE_ENVIRONMENT=production
PHONEPE_PROD_MERCHANT_ID=
PHONEPE_PROD_SALT_KEY=
PHONEPE_PROD_SALT_INDEX=1
PHONEPE_TEST_MERCHANT_ID=
PHONEPE_TEST_SALT_KEY=
PHONEPE_TEST_SALT_INDEX=1

